// Switching the kill switch shouldn't need a password. This covers only starting and stopping this
// one service, for wheel users at the machine itself. Flatpaks can't reach systemd, but a program
// running as me outside a sandbox could switch it off too. Delete "stop" below to ask for a password.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "killswitch.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
