[Unit]
Description=Kill switch: block traffic outside the VPN tunnel
# NetworkManager waits for network-pre.target, so the rules are in place before any network is up.
Wants=network-pre.target
Before=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f /usr/lib/unwritten/killswitch.nft
ExecStop=/usr/bin/nft delete table inet killswitch

[Install]
WantedBy=multi-user.target
